---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { capabilities, contact, profile, projects, seo } from '../data/content';
const featured = projects.filter((project) => project.featured);
const workshop = projects.filter((project) => !project.featured);
const navItems = [{ label: 'Työt', href: '#tyot' }, { label: 'Verstas', href: '#verstas' }, { label: 'Minusta', href: '#minusta' }, { label: 'Yhteys', href: '#yhteys' }];
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage}>
  <Header name={profile.name} nav={navItems} />
  <main id="sisalto">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Teknologiakasvatus · pelit · luova teknologia</p>
          <h1 id="hero-title">{profile.summary}</h1>
          <p class="lead">{profile.introduction}</p>
          <div class="cta-row"><a class="button" href="#tyot">Katso valitut työt <span aria-hidden="true">↘</span></a><a class="text-link" href="#yhteys">Ota yhteyttä <span aria-hidden="true">↓</span></a></div>
        </div>
        <aside class="hero-note" aria-label="Nykyinen suunta">
          <p class="note-label">Nyt työn alla</p><p class="note-main">Tekoälyn domestikaatio koulussa</p><p>Kasvatustieteen maisteriopinnot · Educational Leadership · Jyväskylän yliopisto</p>
          <div class="signal" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
        </aside>
      </div>
    </section>

    <section class="capability-strip" aria-label="Osaamisen painopisteet"><div class="container capability-grid">
      {capabilities.map((item) => <article><span class="cap-number">{item.number}</span><h2>{item.title}</h2><p>{item.description}</p></article>)}
    </div></section>

    <section id="tyot" class="section"><div class="container">
      <div class="section-heading"><div><p class="kicker">Valitut työt</p><h2>Ideasta toimivaksi tilanteeksi.</h2></div><p>Nämä kokonaisuudet näyttävät, miten yhdistän pedagogiikkaa, teknologiaa, ihmisiä ja tarinallista suunnittelua.</p></div>
      <div class="case-list">{featured.map((project, index) => (
        <article class="case-card" style={`--project-accent:${project.accent}`}>
          <div class="case-visual" aria-hidden="true"><span class="case-index">0{index + 1}</span><div class="orb"></div><p>{project.category}</p></div>
          <div class="case-copy"><div class="meta"><span>{project.year}</span><span>{project.status}</span></div><h3>{project.name}</h3><p class="case-summary">{project.summary}</p><dl><div><dt>Oma rooli</dt><dd>{project.role}</dd></div><div><dt>Näyttö</dt><dd>{project.evidence}</dd></div></dl>{project.href ? <a class="card-link" href={project.href}>Tutustu projektiin <span aria-hidden="true">↗</span></a> : <span class="coming">Laajempi case tulossa</span>}</div>
        </article>
      ))}</div>
    </div></section>

    <section id="verstas" class="section workshop"><div class="container">
      <div class="workshop-heading"><div><p class="kicker">Verstas</p><h2>Kokeilut kuuluvat näkyviin.</h2></div><p>Täällä idea saa olla pieni, keskeneräinen tai vähän outo. Olennaista on, mitä sillä kokeiltiin ja mitä siitä opittiin.</p></div>
      <div class="workshop-grid">
        {workshop.map((project) => <article class="workshop-card" style={`--project-accent:${project.accent}`}><div class="workshop-symbol" aria-hidden="true"><span></span></div><div class="meta"><span>{project.year}</span><span>{project.status}</span></div><h3>{project.name}</h3><p>{project.summary}</p><ul>{project.tags.map((tag) => <li>{tag}</li>)}</ul>{project.href && <a class="stretched-link" href={project.href}><span class="sr-only">Avaa {project.name}</span><span aria-hidden="true">↗</span></a>}</article>)}
        <article class="workshop-card open-card"><div class="plus" aria-hidden="true">+</div><h3>Seuraava kokeilu</h3><p>Verstas ei ole valmis kokoelma. Se kasvaa uusien prototyyppien, pelien ja teknisten testien mukana.</p></article>
      </div>
      <p class="archive-link"><a href="https://github.com/kala91">Kaikki julkiset projektit GitHubissa <span aria-hidden="true">→</span></a></p>
    </div></section>

    <section id="minusta" class="section about-section"><div class="container about-grid">
      <div><p class="kicker">Minusta</p><h2>Välineet vaihtuvat.<br />Ydin pysyy.</h2></div>
      <div class="about-copy"><p class="about-lead">{profile.about}</p><p>Olen työskennellyt näyttelijänä, pelikasvattajana, teknologiakasvatuksen koordinaattorina ja itsenäisenä kehittäjänä. Nyt suuntaan kohti opetusteknologian ja tekoälyn käyttöönoton asiantuntijatehtäviä.</p><div class="journey" aria-label="Ammatillinen polku"><span>Esitys</span><i></i><span>Pelit</span><i></i><span>Teknologiakasvatus</span><i></i><span>Tekoäly ja oppiminen</span></div></div>
    </div></section>

    <section id="yhteys" class="contact-section"><div class="container contact-grid">
      <div><p class="kicker">Yhteys</p><h2>Rakennetaanko jotain,<br />jolle ei vielä ole mallia?</h2></div>
      <div class="contact-links"><a href={contact.linkedin}><span>Yhteydenotto</span>LinkedIn · aleksihoyla<b aria-hidden="true">↗</b></a><a href={contact.github}><span>Projektit</span>GitHub · kala91<b aria-hidden="true">↗</b></a><p class="cv-note"><span>Ansioluettelo</span>CV saatavilla pyydettäessä LinkedInin kautta.</p></div>
    </div></section>
  </main>
  <Footer />
</BaseLayout>
